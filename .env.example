# Keep the local JSON content source until a Storyblok space has been created
# and its content models and stories are ready.
CONTENT_SOURCE=json

# Storyblok Content Delivery API configuration (used only during the build).
# Set these in your local .env file or the static site's build environment.
STORYBLOK_ACCESS_TOKEN=
STORYBLOK_VERSION=published
STORYBLOK_REGION=eu
