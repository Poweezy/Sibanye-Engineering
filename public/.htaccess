# SES website — server configuration (Apache/cPanel)
# See docs/DECISIONS.md ADR-012b and docs/HANDOVER.md.

Options -Indexes

# Block dotfiles and source-control directories
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Inline module hashes are exact build outputs; scripts/smoke-test.mjs
  # verifies each production module against this policy. Inline style
  # attributes support per-item CSS custom properties. No third-party script,
  # frame, API, image or font origins are allow-listed.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-Rkesk0jZPJFb/KwwbytZzp7zVn3OJFvA/mkek/1JDkk=' 'sha256-KtCJ3NHYzV9wvyEy7m0JtspbKGLkjxD1jAYmFwTEQk0=' 'sha256-Vc3mB2Jrg/ia7c2BpLOTqfqJEE+LX3Mqecvkc06YXhc=' 'sha256-JWlsSV9VAezGb6XmZu1IpAzoWB25cJLVgMy+Pu7eQnw=' 'sha256-mSxIbDsei8ROKBZK+CT/VD26+L2jOHQFS9sLu+zPP5s=' 'sha256-rtd6GwgQuJbfjqMp7Ikw5Xe1c50xNvuiJZDLcQBbtmI=' 'sha256-GqXi/qAFlCiKWIRW0SIysS4D+5POywoKD5oFn2gbUjo='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests"
</IfModule>

# Long-lived caching for fingerprinted build assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
