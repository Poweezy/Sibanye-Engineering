---
/**
 * Official SES logo.
 * Source: public/logo.png (supplied by SES, 2026-10-21) — processed into
 * public/logo-ses.png by scripts/process-logo.mjs (background knockout).
 * On dark surfaces the black lettering cannot read on navy, so the mark
 * sits on a white chip (light variant). Vector artwork + a reversed
 * variant remain requested — see docs/content-open-items.md item 4.
 */
interface Props {
  /** `light` for dark backgrounds (white chip), `dark` for light backgrounds. */
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---

<a href="/" class="group inline-flex items-center" aria-label="Sibanye Engineering Solutions — home">
  <span class={variant === 'light' ? 'inline-flex items-center bg-white px-3 py-1.5' : 'inline-flex items-center'}>
    <img
      src="/logo-ses.png"
      alt="Sibanye Engineering Solutions logo"
      width="566"
      height="360"
      class="h-10 w-auto"
      loading="eager"
      decoding="async"
    />
  </span>
</a>
