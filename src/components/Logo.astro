---
/**
 * Official SES logo (monogram).
 * Source: public/SIBANYE-LOGO-(OFFICIAL).jpg (supplied by SES, 2026-10-22) —
 * processed into public/logo-ses.png by scripts/process-logo.mjs (amber-field
 * knockout, monogram crop 517×360).
 * On dark surfaces the black lettering cannot read, so the mark sits on a
 * white chip (light variant). Vector artwork + a reversed variant remain
 * requested — see docs/content-open-items.md item 4.
 */
interface Props {
  /** `light` for dark backgrounds (white chip), `dark` for light backgrounds. */
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const onDark = variant === 'light';
---

<a href="/" class="group inline-flex items-center gap-3" aria-label="Sibanye Engineering Solutions — home">
  <span class={onDark ? 'inline-flex items-center bg-white px-2.5 py-2' : 'inline-flex items-center'}>
    <img
      src="/logo-ses.png"
      alt="Sibanye Engineering Solutions logo"
      width="517"
      height="360"
      class="h-9 w-auto"
      loading="eager"
      decoding="async"
    />
  </span>
  <span class={`hidden flex-col leading-tight sm:flex ${onDark ? 'text-white' : 'text-ink-900'}`}>
    <span class="font-display text-sm font-bold tracking-[0.08em]">SIBANYE</span>
    <span class={`text-[10px] font-medium uppercase tracking-[0.3em] ${onDark ? 'text-accent-400' : 'text-accent-700'}`}>
      Engineering Solutions
    </span>
  </span>
</a>
