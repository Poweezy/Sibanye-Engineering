---
/**
 * Interior page hero — dark band with blueprint texture and amber flare,
 * consistent with the homepage hero treatment.
 */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  /** Optional full-bleed photo backdrop (WebP derivative under /images/hero/). */
  image?: string;
}

const { eyebrow, title, intro, image } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink-950 text-white">
  <div class="blueprint absolute inset-0" aria-hidden="true"></div>
  <!-- Optional photographic backdrop (About page): decorative, non-interactive,
       dimmed and scrimmed so the copy column keeps full contrast. -->
  {image && (
    <img
      src={image}
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    />
  )}
  {image && <div class="pointer-events-none absolute inset-0 bg-ink-950/25" aria-hidden="true"></div>}
  {image && (
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/75 via-ink-950/40 to-ink-950/10"
      aria-hidden="true"
    ></div>
  )}
  {image && (
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/10 to-ink-950/30"
      aria-hidden="true"
    ></div>
  )}
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-40 w-full" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <!-- Contour line: accent-400 rgb(221,172,67) at low opacity — kept in sync
         with src/styles/global.css tokens (brand law: no retired hex values). -->
    <path d="M0 120 360 60l360 44 360-64 360 76" fill="none" stroke="rgba(221,172,67,0.28)" stroke-width="2"></path>
  </svg>
  <div class="container-x relative pb-16 pt-20 sm:pb-20 sm:pt-24">
    <p class="reveal eyebrow eyebrow--light">{eyebrow}</p>
    <h1 class="reveal mt-5 max-w-3xl text-4xl font-semibold leading-[1.08] text-ink-300 sm:text-5xl">{title}</h1>
    {intro && <p class="reveal mt-5 max-w-2xl text-base leading-relaxed text-ink-300 sm:text-lg">{intro}</p>}
  </div>
</section>
