---
import Icon from './Icon.astro';

/* Capability list and contract standards from the approved proposal (§12,
   sourced from the SES 2026 capability statement). */
const capabilities = [
  'Engineering advisory',
  'Project management',
  'Programme management',
  'Construction supervision',
  'Quality assurance',
  'Quality control',
  'Budget management',
  'Risk assessment',
  'Contract management',
  'Project controls',
  'Renewable energy',
  'Infrastructure development',
];
---

<section class="relative isolate bg-ink-900 text-white">
  <!-- ADR-024 approved generative texture (proposal-I): faint always-on depth
       behind the capability list; decorative only, aria-hidden, no pointer
       interception; hidden below 48rem and under reduced motion. -->
  <span class="ses-bgimg ses-bgimg--static" aria-hidden="true" style="--ses-bgimg-opacity: 0.5">
    <img
      src="/images/engineering-backgrounds/engineering-bg-texture.webp"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </span>
  <div class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <p class="eyebrow eyebrow--light">Our Capabilities</p>
      <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">Engineering and project delivery</h2>
      <p class="mt-5 max-w-md text-base leading-relaxed text-ink-300">
        Published capabilities include engineering advisory, project management, construction
        supervision, quality assurance and project controls.
      </p>
      <a href="/capabilities/" class="btn-primary mt-8">View Our Capabilities</a>
    </div>

    <div class="reveal">
      <ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {
          capabilities.map((c) => (
            <li class="flex items-center gap-3 border-b border-white/20 pb-3 text-sm text-ink-200">
              <Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" />
              {c}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-xs leading-relaxed text-ink-400">
        Contract management experience spans FIDIC, JBCC, GCC, NEC and EPC forms of contract, as
        recorded in the SES 2026 capability statement.
      </p>
    </div>
  </div>
</section>
