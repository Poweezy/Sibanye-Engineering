---
import Icon from './Icon.astro';
import HeroBackdrop from './HeroBackdrop.astro';
---

<section class="ses-hero relative isolate min-h-[min(850px,calc(100svh-4rem))] overflow-hidden bg-ink-950 text-white">
  <HeroBackdrop />

  <!-- Atmospheric light adds depth over the blueprint plate. -->
  <div
    class="ses-hero__atmosphere pointer-events-none absolute inset-0 z-0"
    aria-hidden="true"
  ></div>

  <!-- Full-bleed dark veil — deepens the hero backdrop below the copy layer
       (z-10), whose calibrated contrast stays untouched. -->
  <div
    class="ses-hero__overlay pointer-events-none absolute inset-0 z-[5]"
    aria-hidden="true"
  ></div>

  <div class="container-x relative z-10 flex min-h-[min(850px,calc(100svh-4rem))] items-center py-24 sm:py-28 lg:py-32">
    <div class="ses-hero__copy max-w-3xl">
      <p class="reveal eyebrow eyebrow--light">Engineering advisory &amp; project delivery</p>

      <h1 class="reveal mt-6 max-w-[900px] text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl xl:text-[5.4rem]">
        <span class="text-ink-300">Engineering for</span>
        <span class="ses-hero__headline-accent block text-accent-300">infrastructure projects.</span>
      </h1>

      <p class="reveal mt-7 max-w-xl text-base leading-relaxed text-ink-100 sm:text-lg">
        Engineering advice, project management and construction supervision across Eswatini and
        Southern Africa.
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-3 sm:gap-4">
        <a href="/contact/#enquiry" class="btn-primary">
          Discuss Your Project
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/capabilities/" class="btn-outline-light">Explore Our Capabilities</a>
      </div>

      <div class="reveal mt-14 flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-ink-200" aria-hidden="true">
        <span class="inline-block h-9 w-px bg-gradient-to-b from-accent-400 to-transparent"></span>
        <span>Based in Mbabane, Eswatini</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ses-hero__atmosphere {
    background:
      radial-gradient(ellipse at 76% 47%, rgb(214 156 31 / 0.13), transparent 35%),
      linear-gradient(90deg, rgb(18 16 15 / 0.3), rgb(18 16 15 / 0.08) 55%, transparent 80%);
  }

  /* Full-bleed dark veil over the plate, atmosphere and porthole (z-[5] —
     below the copy container's z-10, so text/CTAs are unaffected). Deepens
     the scene and strengthens the blend into the next section. */
  .ses-hero__overlay {
    background: linear-gradient(
      180deg,
      rgb(12 10 9 / 0.3) 0%,
      rgb(12 10 9 / 0.24) 45%,
      rgb(12 10 9 / 0.42) 100%
    );
  }

  /* Pool of shade behind the copy column — paints INSIDE container-x's
     stacking context (z-10), i.e. above the gear porthole but below the
     text. Invisible over the dark blueprint plate; only tames the bright
     photo when the rotating gear sweeps behind the headline (measured
     photo mean 0.54 sRGB — white text dropped to ~1.4-3.9:1 without it). */
  .ses-hero__copy {
    position: relative;
  }

  .ses-hero__copy::before {
    content: '';
    position: absolute;
    inset: -3rem -4rem -3rem -3rem;
    z-index: -1;
    background: radial-gradient(
      62% 58% at 38% 46%,
      rgb(18 16 15 / 0.58) 0%,
      rgb(18 16 15 / 0.3) 52%,
      transparent 76%
    );
    pointer-events: none;
  }

  /* Soft contact + ambient shadow lifts glyphs off any bright plate lines
     or photo edges that cross them. */
  .ses-hero__copy h1,
  .ses-hero__copy p {
    text-shadow:
      0 1px 2px rgb(12 10 9 / 0.38),
      0 3px 24px rgb(12 10 9 / 0.42);
  }

  .ses-hero__headline-accent {
    text-wrap: balance;
  }

  @media (max-width: 639px) {
    .ses-hero__atmosphere {
      background:
        radial-gradient(ellipse at 80% 78%, rgb(214 156 31 / 0.1), transparent 36%),
        linear-gradient(90deg, rgb(18 16 15 / 0.36), rgb(18 16 15 / 0.08));
    }

    /* Slightly lighter veil on mobile — the hero is viewport-tall. */
    .ses-hero__overlay {
      background: linear-gradient(
        180deg,
        rgb(12 10 9 / 0.26) 0%,
        rgb(12 10 9 / 0.22) 45%,
        rgb(12 10 9 / 0.4) 100%
      );
    }
  }

</style>
