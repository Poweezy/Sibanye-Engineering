---
import Icon from './Icon.astro';
import GearWatermark from './GearWatermark.astro';
---

<section class="relative isolate overflow-hidden bg-ink-950 text-white">
  <!-- Backdrop: blueprint grid + contour art. Placeholder for hero photography
       (real imagery awaited from SES — docs/content-open-items.md). -->
  <div class="blueprint absolute inset-0" aria-hidden="true"></div>
  <svg
    class="absolute inset-0 h-full w-full"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="heroFade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#12100f" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#12100f" stop-opacity="0.92"></stop>
      </linearGradient>
    </defs>
    <path d="M0 520 320 350l260 140 300-190 560 300" fill="none" stroke="rgba(221,172,67,0.4)" stroke-width="2"></path>
    <path d="M0 560 340 390l270 140 320-200 510 270" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="2"></path>
    <circle cx="1140" cy="210" r="170" fill="none" stroke="rgba(221,172,67,0.2)"></circle>
    <circle cx="1140" cy="210" r="115" fill="none" stroke="rgba(221,172,67,0.13)"></circle>
    <path d="M0 700h1440V420L0 560Z" fill="url(#heroFade)"></path>
  </svg>
  <GearWatermark class="top-1/2 right-[-160px] w-[520px] -translate-y-1/2 text-accent-400 opacity-[0.07] sm:right-[-120px] sm:w-[620px] lg:right-[-80px] lg:w-[760px]" />

  <div class="container-x relative py-28 sm:py-36 lg:py-44">
    <div class="max-w-3xl">
      <p class="reveal eyebrow eyebrow--light">Engineering / Infrastructure / Sustainability</p>
      <h1 class="reveal mt-6 text-4xl font-semibold leading-[1.06] sm:text-6xl lg:text-7xl">
        Engineering Infrastructure.<br />
        <span class="text-accent-300">Enabling Sustainable Progress.</span>
      </h1>
      <p class="reveal mt-7 max-w-xl text-base leading-relaxed text-ink-200 sm:text-lg">
        Multidisciplinary engineering, project management and infrastructure advisory services
        delivering practical solutions across Eswatini and Southern Africa.
      </p>
      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href="/contact/#enquiry" class="btn-primary">
          Discuss Your Project
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/capabilities/" class="btn-outline-light">Explore Our Capabilities</a>
      </div>
    </div>

    <div class="reveal mt-16 flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-ink-300" aria-hidden="true">
      <span class="inline-block h-9 w-px bg-gradient-to-b from-accent-400 to-transparent"></span>
      Scroll to explore
    </div>
  </div>
</section>
