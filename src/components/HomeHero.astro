---
import Icon from './Icon.astro';
import GearWatermark from './GearWatermark.astro';
import HeroBackdrop from './HeroBackdrop.astro';
---

<section class="ses-hero relative isolate min-h-[min(850px,calc(100svh-4rem))] overflow-hidden bg-ink-950 text-white">
  <HeroBackdrop />

  <!-- Atmospheric light adds depth over the blueprint plate. -->
  <div
    class="ses-hero__atmosphere pointer-events-none absolute inset-0 z-0"
    aria-hidden="true"
  ></div>

  <!-- Gear porthole — one rotor drives the gear-masked window and the amber
       watermark in lockstep (90s). The photograph inside counter-rotates at
       the same rate, so it appears pinned to the page while the rotating
       gear window sweeps across it, revealing different parts of the image.
       Mask geometry: public/images/gear-mask.svg. -->
  <div
    class="ses-hero__gear pointer-events-none absolute top-1/2 right-[-250px] aspect-square w-[560px] -translate-y-1/2 sm:right-[-230px] sm:w-[700px] lg:right-[-170px] lg:w-[820px] xl:right-[-120px]"
    aria-hidden="true"
  >
    <div class="ses-hero__gear-rotor">
      <div class="ses-hero__gear-window">
        <img
          src="/images/hero/manzini-mall-01.webp"
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="ses-hero__gear-photo"
        />
      </div>
      <GearWatermark spin={false} class="inset-0 h-full w-full text-accent-400 opacity-[0.13]" />
    </div>
  </div>

  <div class="container-x relative z-10 flex min-h-[min(850px,calc(100svh-4rem))] items-center py-24 sm:py-28 lg:py-32">
    <div class="ses-hero__copy max-w-3xl">
      <p class="reveal eyebrow eyebrow--light">Engineering / Infrastructure / Sustainability</p>

      <h1 class="reveal mt-6 max-w-[900px] text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl xl:text-[5.4rem]">
        Engineering that moves
        <span class="ses-hero__headline-accent block text-accent-300">progress forward.</span>
      </h1>

      <p class="reveal mt-7 max-w-xl text-base leading-relaxed text-ink-100 sm:text-lg">
        Engineering, project management and infrastructure advisory for complex projects
        across Eswatini and Southern Africa.
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-3 sm:gap-4">
        <a href="/contact/#enquiry" class="btn-primary">
          Discuss Your Project
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/capabilities/" class="btn-outline-light">Explore Our Capabilities</a>
      </div>

      <div class="reveal mt-14 flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-ink-200" aria-hidden="true">
        <span class="inline-block h-9 w-px bg-gradient-to-b from-accent-400 to-transparent"></span>
        <span>Engineered for what’s next</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ses-hero__atmosphere {
    background:
      radial-gradient(ellipse at 76% 47%, rgb(214 156 31 / 0.13), transparent 35%),
      linear-gradient(90deg, rgb(18 16 15 / 0.22), transparent 72%);
  }

  .ses-hero__gear {
    filter: drop-shadow(0 0 42px rgb(214 156 31 / 0.16));
  }

  /* One rotor spins both the gear-mask window and the amber watermark in
     perfect lockstep (single animation = no drift between them). */
  .ses-hero__gear-rotor {
    position: absolute;
    inset: 0;
    animation: gear-spin 90s linear infinite;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Gear-shaped aperture (same geometry as GearWatermark); rotates with the
     rotor, so the porthole itself turns. The mask's gear silhouette is
     rotationally symmetric, so it never reveals outside the square photo. */
  .ses-hero__gear-window {
    position: absolute;
    inset: 0;
    -webkit-mask-image: url('/images/gear-mask.svg');
    mask-image: url('/images/gear-mask.svg');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center;
    mask-position: center;
  }

  /* The photograph counter-rotates (same 90s, reversed) to cancel the
     rotor's spin — its pixels stay pinned to the viewport while the gear
     window sweeps across it, revealing different parts of the still image. */
  .ses-hero__gear-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: brightness(0.94) saturate(0.92);
    animation: gear-spin 90s linear infinite reverse;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .ses-hero__headline-accent {
    text-wrap: balance;
  }

  @media (max-width: 639px) {
    .ses-hero__gear {
      top: auto;
      right: -180px;
      bottom: -150px;
      width: 420px;
      /* Tailwind v4's -translate-y-1/2 uses the `translate` property, so it
         must be reset here (transform: none has no effect on it). */
      translate: none;
      opacity: 0.92;
    }

    .ses-hero__gear-photo {
      object-position: 58% center;
    }

    .ses-hero__atmosphere {
      background:
        radial-gradient(ellipse at 80% 78%, rgb(214 156 31 / 0.1), transparent 36%),
        linear-gradient(90deg, rgb(18 16 15 / 0.36), rgb(18 16 15 / 0.08));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ses-hero__gear {
      filter: none;
    }

    /* Watermark gets spin={false}; stop the rotor and the photo's
       counter-rotation so the whole porthole renders static. */
    .ses-hero__gear-rotor,
    .ses-hero__gear-photo {
      animation: none;
    }
  }
</style>
