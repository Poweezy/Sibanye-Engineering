---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  /** `dark` renders for dark background bands. */
  tone?: 'light' | 'dark';
}

const { eyebrow, title, intro, align = 'left', tone = 'light' } = Astro.props;
---

<div class={`reveal max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''}`}>
  <p class={`eyebrow ${tone === 'dark' ? 'eyebrow--light' : ''}`}>{eyebrow}</p>
  <h2 class={`mt-4 text-3xl font-semibold sm:text-4xl ${tone === 'dark' ? 'text-white' : ''}`}>
    {title}
  </h2>
  {intro && <p class={`mt-4 text-base leading-relaxed ${tone === 'dark' ? 'text-ink-300' : 'text-muted'}`}>{intro}</p>}
</div>
