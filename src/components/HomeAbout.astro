---
import Icon from './Icon.astro';

/* Mission/vision wording from the approved proposal (§2, sourced from the SES
   capability statement). Values line from the approved design concept —
   pending SES sign-off. */
const pillars = [
  {
    icon: 'compass',
    title: 'Our Mission',
    text: 'To provide cutting-edge and innovative solutions that create shared value for clients and stakeholders.',
  },
  {
    icon: 'eye',
    title: 'Our Vision',
    text: 'To become an internationally respected engineering advisory firm offering sustainable solutions.',
  },
  {
    icon: 'leaf',
    title: 'Our Values',
    text: 'Integrity. Excellence. Collaboration. Sustainability. Professionalism.',
  },
];
---

<section class="bg-white">
  <div class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="reveal">
        <p class="eyebrow">About Sibanye Engineering</p>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">A multidisciplinary engineering practice</h2>
        <p class="mt-5 text-base leading-relaxed text-body">
          Sibanye Engineering Solutions operates as a multidisciplinary engineering practice with
          capabilities spanning civil engineering advisory services, project management, water
          infrastructure, transportation, mining engineering, structures and energy.
        </p>
        <a
          href="/about/"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-600 transition-colors hover:text-accent-700"
        >
          Learn more about us
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:col-span-7">
      {
        pillars.map((p) => (
          <div class="reveal bg-white p-7">
            <Icon name={p.icon} class="h-7 w-7 text-accent-500" />
            <h3 class="mt-5 text-lg font-semibold">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
