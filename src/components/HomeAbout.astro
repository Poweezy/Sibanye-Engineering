---
import Icon from './Icon.astro';

/* VERBATIM CLIENT COPY (ADR-019): mission/vision wording from the approved
   proposal (§2, sourced from the SES capability statement) — including
   "cutting-edge and innovative" — is protected; copy/slop passes must not
   rewrite it. Values line verbatim from capability statement p. 6. */
const pillars = [
  {
    icon: 'compass',
    title: 'Our Mission',
    text: 'Provide cutting-edge and innovative solutions, for creating shared value for all our clients and stakeholders.',
  },
  {
    icon: 'eye',
    title: 'Our Vision',
    text: 'To be an internationally respected engineering advisory firm offering sustainable solutions.',
  },
  {
    icon: 'leaf',
    title: 'Our Values',
    text: 'Futuristic. Respect & Integrity. Playfulness. Participation.',
  },
];
---

<section class="bg-white">
  <div class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="reveal">
        <p class="eyebrow">About Sibanye Engineering</p>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">A multidisciplinary engineering practice</h2>
        <p class="mt-5 text-base leading-relaxed text-body">
          Sibanye Engineering Solutions operates as a multidisciplinary engineering practice with
          capabilities spanning civil engineering advisory services, project management, water
          infrastructure, transportation, mining engineering, structures and energy.
        </p>
        <a
          href="/about/"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-700 transition-colors hover:text-ink-900"
        >
          Learn more about us
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:col-span-7">
      {
        pillars.map((p, i) => (
          <div class={`reveal bg-white p-7 ${i === 0 ? 'border-l-2 border-accent-500' : 'transition-colors hover:border-l-2 hover:border-accent-500'}`}>
            <Icon name={p.icon} class="h-7 w-7 text-accent-500" />
            <h3 class="mt-5 text-lg font-semibold">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
