---
/** Project photo when supplied, otherwise a decorative engineering graphic. */
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  title: string;
  image?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { title, image, class: className = 'aspect-[16/10]', loading = 'lazy' } = Astro.props;
---

{
  image ? (
    <img
      src={image}
      alt={title}
      loading={loading}
      decoding="async"
      class={`w-full object-cover ${className}`}
    />
  ) : (
    <ImagePlaceholder label={title} class={className} />
  )
}