---
/**
 * Services marquee — quiet, single-idea motion strip listing the approved
 * service names from services.json. Second track is an aria-hidden duplicate
 * so the track loops without a visible join; reduced motion renders one
 * static wrapped list.
 */
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const names = services.map((s) => s.data.title);
---

<section class="marquee border-y border-line bg-white py-5" aria-label="Our engineering disciplines">
  <div class="marquee-track items-center">
    {
      [0, 1].map((copy) => (
        <ul
          class={`flex shrink-0 items-center gap-10 pr-10 ${copy === 1 ? 'marquee-copy--dupe' : ''}`}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {names.map((name) => (
            <li class="flex items-center gap-10 whitespace-nowrap font-display text-sm font-semibold uppercase tracking-[0.28em] text-ink-400">
              <span>{name}</span>
              <span class="h-1.5 w-1.5 shrink-0 rotate-45 bg-accent-500" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>