---
/**
 * HeroBackdrop — approved proposal-B "hero grid" blueprint plate.
 *
 * docs/creative-proposals/proposal-B-hero-grid-16x9.png (served from
 * public/images/hero/) fills the hero as a full-bleed technical-drawing
 * backdrop that sits behind the gear porthole. A quiet grade protects
 * header, headline and CTA contrast and eases the plate into the next
 * section. Decorative: aria-hidden, pointer-events none, -z-10 behind all
 * foreground content.
 */
const src = '/images/hero/proposal-b-hero-grid-16x9.webp';
---

<div class="hero-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
  <img
    src={src}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="hero-backdrop__plate"
  />
  <div class="hero-backdrop__grade"></div>
  <div class="hero-backdrop__edge"></div>
</div>

<style>
  .hero-backdrop__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-backdrop__grade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(18 16 15 / 0.42) 0%,
        rgb(18 16 15 / 0.06) 30%,
        rgb(18 16 15 / 0.12) 68%,
        rgb(18 16 15 / 0.85) 100%
      ),
      linear-gradient(
        90deg,
        rgb(18 16 15 / 0.62) 0%,
        rgb(18 16 15 / 0.24) 46%,
        rgb(18 16 15 / 0.14) 100%
      );
  }

  .hero-backdrop__edge {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 120px rgb(0 0 0 / 0.3);
  }

  @media (max-width: 639px) {
    .hero-backdrop__plate {
      object-position: 62% center;
    }

    .hero-backdrop__grade {
      background:
        linear-gradient(
          180deg,
          rgb(18 16 15 / 0.5) 0%,
          rgb(18 16 15 / 0.18) 45%,
          rgb(18 16 15 / 0.85) 100%
        ),
        linear-gradient(90deg, rgb(18 16 15 / 0.35), rgb(18 16 15 / 0.2));
    }
  }
</style>
