---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  intro?: string;
}

const {
  title = 'Have a project in mind?',
  intro = 'Tell us about your infrastructure, engineering or programme delivery needs — our team responds to every enquiry.',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink-950 text-white blueprint">
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-32 w-full" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <!-- Contour line: accent-400 rgb(221,172,67) at low opacity — same family as
         PageHero contour (brand law: no retired hex values). -->
    <path d="M0 128 320 72l300 40 340-72 480 92" fill="none" stroke="rgba(221,172,67,0.22)" stroke-width="2"></path>
  </svg>
  <div class="container-x relative flex flex-col items-start gap-8 py-16 sm:py-20 lg:flex-row lg:items-center lg:justify-between">
    <div class="reveal max-w-xl">
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
      <p class="mt-3 text-base leading-relaxed text-ink-300">{intro}</p>
    </div>
    <div class="reveal flex flex-wrap gap-4">
      <a href="/contact/#enquiry" class="btn-primary">
        Start an Enquiry
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a href="https://wa.me/26878024964" target="_blank" rel="noopener noreferrer" class="btn-outline-light">
        <Icon name="whatsapp" class="h-4 w-4" />
        WhatsApp Us
      </a>
    </div>
  </div>
</section>
