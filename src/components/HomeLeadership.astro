---
import Icon from './Icon.astro';
import LeaderAvatar from './LeaderAvatar.astro';

interface Props {
  leaders: { id: string; name: string; role: string; credentials: string[]; photo?: string }[];
}

const { leaders } = Astro.props;
---

<section class="bg-white">
  <div class="container-x py-20 sm:py-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Leadership</p>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Experienced. Qualified. Committed.</h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          The engineers behind SES's work — names, roles and professional credentials as published
          in the company capability statement.
        </p>
      </div>
      <a
        href="/leadership/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent-700 transition-colors hover:text-ink-900"
      >
        Meet our leadership
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        leaders.map((l) => (
          <li class="reveal">
            <article class="card flex h-full flex-col gap-5 p-7 sm:flex-row sm:items-start">
              <LeaderAvatar name={l.name} photo={l.photo} />
              <div>
                <h3 class="text-xl font-semibold">{l.name}</h3>
                <p class="mt-1 text-sm font-medium text-accent-700">{l.role}</p>
                <ul class="mt-4 flex flex-wrap gap-2" aria-label="Credentials">
                  {l.credentials.map((c) => (
                    <li class="border border-line bg-paper px-2.5 py-1 text-xs font-medium text-body">{c}</li>
                  ))}
                </ul>
                <a
                  href={`/leadership/#${l.id}`}
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 transition-colors hover:text-ink-900"
                >
                  Full profile
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
