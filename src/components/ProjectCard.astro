---
import ImagePlaceholder from './ImagePlaceholder.astro';
import ProjectImage from './ProjectImage.astro';

interface Props {
  project: { id: string; title: string; sectors: string[]; client?: string; value?: string; location?: string; image?: string };
  sectorTitles: Record<string, string>;
  /** 'dark' renders the card for dark bands. */
  tone?: 'light' | 'dark';
}

const { project, sectorTitles, tone = 'light' } = Astro.props;
---

<article class={`group h-full ${tone === 'dark' ? 'border border-white/10 bg-ink-900' : 'card'}`}>
  <a href={`/projects/${project.id}/`} class="block h-full">
    <ProjectImage title={project.title} image={project.image} class="aspect-[16/10]" />
    <div class="p-6">
      <p class={`flex flex-wrap gap-2 text-[0.62rem] font-semibold uppercase tracking-[0.18em] ${tone === 'dark' ? 'text-accent-300' : 'text-accent-700'}`}>
        {project.sectors.map((s) => (
          <span class={`border px-2 py-1 ${tone === 'dark' ? 'border-white/10' : 'border-line'}`}>{sectorTitles[s] ?? s}</span>
        ))}
      </p>
      <h3 class={`mt-3 text-xl font-semibold ${tone === 'dark' ? 'text-white' : ''}`}>{project.title}</h3>
      <p class={`mt-2 text-sm ${tone === 'dark' ? 'text-ink-300' : 'text-muted'}`}>
        {[project.location, project.client, project.value].filter(Boolean).join(' · ') || 'Details on the project page'}
      </p>
    </div>
  </a>
</article>
