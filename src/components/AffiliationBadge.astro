---
interface OrganizationBadge {
  kind: 'organization';
  name: string;
  fullName: string;
  logo: string;
  href: string;
  darkBackground?: boolean;
}

interface AccreditationBadge {
  kind: 'accreditation';
  name: string;
  fullName: string;
  logo: string;
}

interface BbbeeBadge {
  kind: 'bbee';
  name: string;
}

interface Props {
  badge: OrganizationBadge | AccreditationBadge | BbbeeBadge;
}

const { badge } = Astro.props;
---

{badge.kind === 'organization' ? (
  <a
    class:list={[
      'affiliation-mark card flex h-16 w-36 shrink-0 items-center justify-center rounded-lg border border-line px-4 transition-colors',
      badge.darkBackground && 'bg-ink-900',
    ]}
    href={badge.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${badge.name}: ${badge.fullName}`}
    title={badge.fullName}
  >
    <img
      src={badge.logo}
      alt=""
      class="max-h-8 w-auto max-w-full object-contain"
      loading="lazy"
      decoding="async"
    />
  </a>
) : badge.kind === 'accreditation' ? (
  <div
    class="affiliation-mark card flex h-16 w-36 shrink-0 items-center justify-center rounded-lg border border-line px-4"
    role="img"
    aria-label={badge.name}
    title={badge.fullName}
  >
    <img
      src={badge.logo}
      alt=""
      class="max-h-8 w-auto max-w-full object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>
) : (
  <div
    class="affiliation-mark card flex h-16 w-36 shrink-0 items-center justify-center gap-3 rounded-lg border border-line px-4"
    role="img"
    aria-label={badge.name}
    title={badge.name}
  >
    <div
      class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-full border-2 border-amber-500 bg-ink-900 text-white"
      aria-hidden="true"
    >
      <span class="text-[0.45rem] font-semibold uppercase tracking-[0.12em] text-amber-300">Level</span>
      <span class="text-xl font-bold leading-none">1</span>
    </div>
    <span class="text-xs font-semibold leading-tight text-ink-900">B-BBEE</span>
  </div>
)}

<style>
  .affiliation-mark img {
    filter: grayscale(1);
    transition: filter 400ms ease;
  }

  .affiliation-mark:hover img,
  .affiliation-mark:focus-visible img {
    filter: grayscale(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .affiliation-mark img {
      transition: none;
    }
  }
</style>
