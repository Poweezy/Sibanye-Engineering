---
import Icon from './Icon.astro';
import { sectorBackgrounds } from '../lib/serviceBackgrounds';

interface Props {
  sectors: { id: string; title: string; icon: string; blurb: string }[];
}

const { sectors } = Astro.props;
---

<section class="bg-white">
  <div class="container-x py-20 sm:py-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Market Sectors</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Sectors covered by SES</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        SES lists experience across the sectors below. Published project references are linked
        where available.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sectors.map((s, i) => (
          <li class="reveal" style={`--reveal-delay: ${Math.min(i * 60, 360)}ms`}>
            <a
              href={`/sectors/#${s.id}`}
              class="card group block h-full overflow-hidden transition-colors hover:border-accent-500"
            >
              {sectorBackgrounds[s.id] && (
                <span class="block aspect-[16/9] overflow-hidden">
                  <img
                    src={sectorBackgrounds[s.id]}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </span>
              )}
              <span class="block p-6 transition-colors group-hover:bg-ink-950">
                <span class="inline-flex h-12 w-12 items-center justify-center border border-accent-200 bg-accent-100 text-accent-700 transition-colors group-hover:border-ink-700 group-hover:bg-accent-500 group-hover:text-ink-950">
                  <Icon name={s.icon} class="h-6 w-6" />
                </span>
                <h3 class="mt-4 text-lg font-semibold text-ink-900 transition-colors group-hover:text-white">{s.title}</h3>
                <span class="mt-1.5 block text-sm leading-relaxed text-muted transition-colors group-hover:text-ink-300">{s.blurb}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
