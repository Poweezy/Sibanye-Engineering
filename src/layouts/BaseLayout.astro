---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  /** Page title without the site suffix. */
  title: string;
  /** Meta description. Falls back to the approved positioning statement. */
  description?: string;
}

const SITE_NAME = 'Sibanye Engineering Solutions';
const {
  title,
  description = 'Multidisciplinary engineering, project management and infrastructure advisory services delivering practical solutions across Eswatini and Southern Africa.',
} = Astro.props;

const pageTitle =
  title === SITE_NAME
    ? `${title} | Engineering Infrastructure. Enabling Sustainable Progress.`
    : `${title} | ${SITE_NAME}`;
const site = Astro.site ?? new URL('https://www.sibanyeengineering.com');
const canonical = new URL(Astro.url.pathname, site).href;

/* JSON-LD Organization — all fields from the SES 2026 capability statement. */
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: site.href,
  logo: new URL('/logo-official.jpg', site).href,
  description,
  email: 'corporate@sibanyeengineering.com',
  telephone: ['+268 2404 5512', '+268 7802 4964'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Suite NC202/203C, Nedbank Centre, Swazi Plaza, cnr Sozisa & Dr Sishayi Road',
    addressLocality: 'Mbabane',
    addressCountry: 'SZ',
  },
  areaServed: 'Eswatini and Southern Africa',
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#12100f" />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-accent-500 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      // Escape-to-close for the mobile navigation. Registered ONCE at module
      // scope: `document` persists across view transitions, so a listener
      // added inside astro:page-load would stack on every client-side
      // navigation. It queries the live DOM, so it always sees the current nav.
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
        const nav = document.querySelector('[data-mobile-nav]');
        if (toggle && nav && toggle.getAttribute('aria-expanded') === 'true') {
          nav.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });

      // Runs on initial load AND after every client-side (view-transition)
      // navigation: re-queries the swapped DOM, so listeners never go stale.
      document.addEventListener('astro:page-load', () => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Mobile navigation toggle
        const toggle = document.querySelector('[data-nav-toggle]');
        const nav = document.querySelector('[data-mobile-nav]');
        if (toggle instanceof HTMLElement && nav) {
          toggle.addEventListener('click', () => {
            const open = !nav.classList.toggle('hidden');
            toggle.setAttribute('aria-expanded', String(open));
          });
        }

        // Enquiry feedback — public/api/enquiry.php redirects back to
        // /contact/?sent=1#enquiry (success) or ?sent=0#enquiry (failure).
        // The URL parameter is cleaned afterwards to keep links shareable.
        const sent = new URLSearchParams(location.search).get('sent');
        if (sent !== null) {
          const status = document.querySelector('[data-form-status]');
          if (status instanceof HTMLElement) {
            status.textContent =
              sent === '1'
                ? 'Thank you — your enquiry has been sent. Our team will respond shortly.'
                : 'Sorry — your enquiry could not be sent right now. Please email corporate@sibanyeengineering.com, call +268 2404 5512 or message us on WhatsApp.';
            status.classList.remove('hidden');
            status.setAttribute('tabindex', '-1');
            status.focus({ preventScroll: true });
            status.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
          }
          history.replaceState({}, '', location.pathname + '#enquiry');
        }

        // Scroll reveal — disabled when the user prefers reduced motion
        const targets = document.querySelectorAll<HTMLElement>('.reveal');
        if (reduceMotion || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('in-view'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in-view');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
          );
          targets.forEach((el) => io.observe(el));
        }
      });
    </script>
  </body>
</html>
