---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { serviceBackgrounds } from '../../lib/serviceBackgrounds';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services"
  description="Engineering services across civil, water and sanitation, transportation, energy, structural, mining, project management and industrial & commercial disciplines."
>
  <PageHero
    eyebrow="Our Services"
    title="Eight engineering and delivery disciplines"
    intro="Civil, water, transport, energy, structural and mining engineering, alongside project management and industrial and commercial buildings."
    image="/images/hero/sunset-industrial-blueprint.webp"
  />

  <section class="bg-white">
    <div class="container-x py-20 sm:py-24">
      <ul class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <li class="group bg-white">
              <a href={`/services/${s.id}/`} class="block h-full transition-colors group-hover:bg-ink-950">
                  {serviceBackgrounds[s.id] && (
                    <span class="block aspect-[16/9] overflow-hidden">
                      <img
                        src={serviceBackgrounds[s.id]}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    </span>
                  )}
                <span class="block p-7">
                  <Icon name={s.data.icon} class="h-7 w-7 text-accent-500" />
                  <h2 class="mt-5 text-lg font-semibold transition-colors group-hover:text-white">{s.data.title}</h2>
                  <span class="mt-2 block text-sm leading-relaxed text-muted transition-colors group-hover:text-ink-300">
                    {s.data.tagline}
                  </span>
                  <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent-700 transition-colors group-hover:text-accent-300">
                    Explore
                    <Icon name="arrow" class="h-3.5 w-3.5" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-xs leading-relaxed text-muted">
        Service descriptions are drawn from the SES 2026 capability statement. Detailed
        discipline-specific scope wording is pending SES sign-off.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
