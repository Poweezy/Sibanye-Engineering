---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import HomeStats from '../components/HomeStats.astro';

/* All copy grounded in the SES 2026 capability statement. VERBATIM CLIENT COPY
   (ADR-019): the mission text — including "cutting-edge and innovative" — and
   the values + socio-economic development wording (statement p. 6, graphical
   page transcribed verbatim) are protected from copy/slop rewrites. */
const pillars = [
  {
    icon: 'compass',
    title: 'Our Mission',
    text: 'Provide cutting-edge and innovative solutions, for creating shared value for all our clients and stakeholders.',
  },
  {
    icon: 'eye',
    title: 'Our Vision',
    text: 'To be an internationally respected engineering advisory firm offering sustainable solutions.',
  },
];

/* Values verbatim from capability statement p. 6 (graphical page transcribed);
   icons are the site's decorative stand-ins for the statement's own glyphs. */
const values = [
  { icon: 'eye', name: 'Futuristic' },
  { icon: 'check', name: 'Respect & Integrity' },
  { icon: 'bolt', name: 'Playfulness' },
  { icon: 'bridge', name: 'Participation' },
];

const facts = [
  { label: 'Headquarters', value: 'Mbabane, Eswatini' },
  { label: 'Regional presence', value: 'Bryanston, Sandton, South Africa' },
  { label: 'Disciplines', value: 'Civil · Water · Transportation · Energy · Structural · Mining' },
  { label: 'Engagement models', value: 'Advisory · Project & programme management · Design & supervision' },
];
---

<BaseLayout
  title="About"
  description="Sibanye Engineering Solutions is a multidisciplinary engineering advisory and project management practice based in Mbabane, Eswatini, serving clients across Eswatini and Southern Africa."
>
  <PageHero
    eyebrow="About SES"
    title="A multidisciplinary engineering practice"
    intro="Engineering advisory and project management from Mbabane, with a regional presence in South Africa."
    image="/images/hero/engineers-golden-industrial-site.webp"
  />

  <section class="bg-white">
    <div class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-7">
        <p class="eyebrow">Who We Are</p>
        <h2 class="mt-4 text-3xl font-semibold">Engineering advisory and project management</h2>
        <div class="mt-6 space-y-5 text-base leading-relaxed text-body">
          <p>
            Sibanye Engineering Solutions (SES) is a multidisciplinary engineering advisory and
            project management practice headquartered in Mbabane, Eswatini, with a regional
            presence in Bryanston, Sandton. Our capabilities span civil engineering advisory
            services, project management, water infrastructure, transportation, mining
            engineering, structures and energy.
          </p>
          <p>
            We work with public institutions, state-owned enterprises and private clients. The
            project references include water-supply programmes, renewable energy, roads, buildings
            and industrial facilities.
          </p>
          <p class="text-sm text-muted">
            Full company profile, history and team composition are being finalised with SES — no
            unverified details are published.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="reveal card divide-y divide-line">
          {
            facts.map((f) => (
              <div class="flex flex-col gap-1 p-6 sm:flex-row sm:items-baseline sm:justify-between">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">{f.label}</dt>
                <dd class="text-sm font-medium text-ink-900 sm:text-right">{f.value}</dd>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-paper-2">
    <div class="container-x grid gap-px overflow-hidden border border-line bg-line py-20 sm:grid-cols-2 sm:py-24">
      {
        pillars.map((p) => (
          <div class="reveal bg-white p-8 sm:p-10">
            <Icon name={p.icon} class="h-7 w-7 text-accent-500" />
            <h3 class="mt-5 text-2xl font-semibold">{p.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-body">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="container-x py-16">
      <div class="reveal">
        <p class="eyebrow">Our Values</p>
        <h2 class="mt-4 text-3xl font-semibold">What we hold ourselves to</h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
          The four values SES publishes in its 2026 capability statement, reproduced verbatim.
        </p>
      </div>
      <ul class="mt-10 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <li class="reveal bg-white p-7">
              <Icon name={v.icon} class="h-7 w-7 text-accent-500" />
              <h3 class="mt-5 text-lg font-semibold">{v.name}</h3>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10 border border-line bg-paper p-8 sm:p-10">
        <Icon name="building" class="h-7 w-7 text-accent-500" />
        <h3 class="mt-5 text-2xl font-semibold">Socio-economic development</h3>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-body">
          SES believe in and supports Skills Development and Social Upliftment and therefore gives
          back to society and communities through programmes including: Young engineers initiative
          providing mentorship and training to graduates; social upliftment and development projects
          across various communities focusing on education; young talent and development.
        </p>
      </div>
    </div>
  </section>

  <HomeStats />
  <CtaBand title="Want to work with us?" />
</BaseLayout>
