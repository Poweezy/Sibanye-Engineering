---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import LeaderAvatar from '../components/LeaderAvatar.astro';

const preferredOrder = ['nkonyane-musa', 'frans-pienaar'];
const leaders = (await getCollection('leadership')).sort(
  (a, b) => preferredOrder.indexOf(a.id) - preferredOrder.indexOf(b.id),
);
---

<BaseLayout
  title="Leadership"
  description="Meet the leadership of Sibanye Engineering Solutions — registered engineers with experience across water, transportation, energy, structures and programme delivery."
>
  <PageHero
    eyebrow="Leadership"
    title="Experienced. Qualified. Committed."
    intro="Our leadership team carries professional registrations and decades of combined experience across the disciplines we practise."
  />

  <section class="bg-white">
    <div class="container-x py-20 sm:py-24">
      <ul class="grid gap-6 md:grid-cols-2">
        {
          leaders.map((l) => (
            <li class="reveal" id={l.id}>
              <article class="card flex h-full flex-col p-8">
                <div class="flex items-center gap-5">
                  <LeaderAvatar name={l.data.name} photo={l.data.photo} />
                  <div>
                    <h2 class="text-xl font-semibold">{l.data.name}</h2>
                    <p class="mt-1 text-sm font-medium text-accent-700">{l.data.role}</p>
                  </div>
                </div>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Credentials">
                  {l.data.credentials.map((c) => (
                    <li class="border border-line bg-paper px-2.5 py-1 text-xs font-medium text-body">{c}</li>
                  ))}
                </ul>
                {l.data.bio && (
                  <div class="mt-5 space-y-4 text-base leading-relaxed text-body">
                    {l.data.bio.split('\n\n').map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-12 border border-dashed border-line bg-paper p-6 text-sm leading-relaxed text-muted">
        <p>
          <strong class="text-ink-900">Content integrity note.</strong> Leadership biographies,
          photographs and the final wording of professional credentials are published as approved
          by SES, reproduced from the SES 2026 capability statement (pp. 4–5).
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Want to discuss a project with our team?" />
</BaseLayout>
