---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { sectorBackgrounds } from '../lib/serviceBackgrounds';

const sectors = (await getCollection('sectors')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');

---

<BaseLayout
  title="Market Sectors"
  description="SES delivers engineering, project management and advisory services across water and sanitation, energy, transportation, mining, infrastructure, structures, industrial and commercial, healthcare and agriculture sectors."
>
  <PageHero
    eyebrow="Market Sectors"
    title="Driving development across key sectors"
    intro="We bring engineering expertise to the sectors that power growth, support communities and build a more sustainable future."
    image="/images/hero/sectors-hero.webp"
  />

  <section class="bg-white">
    <div class="container-x py-20 sm:py-24">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sectors.map((s) => {
            const related = projects
              .filter((p) => p.data.sectors.includes(s.id))
              .sort((a, b) => a.data.order - b.data.order);
            return (
              <section id={s.id} class="card scroll-mt-24 overflow-hidden">
                {sectorBackgrounds[s.id] && (
                  <span class="block aspect-[16/9] overflow-hidden">
                    <img
                      src={sectorBackgrounds[s.id]}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </span>
                )}
                <div class="p-6">
                  <div class="flex items-start gap-4">
                    <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-accent-200 bg-accent-100 text-accent-700">
                      <Icon name={s.data.icon} class="h-6 w-6" />
                    </span>
                    <div>
                      <h2 class="text-xl font-semibold">{s.data.title}</h2>
                      <p class="mt-2 text-sm leading-relaxed text-muted">{s.data.blurb}</p>
                    </div>
                  </div>
                  <div class="mt-5">
                    <p class="mt-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
                      {related.length > 0
                        ? `${related.length} project reference${related.length === 1 ? '' : 's'}`
                        : 'References being prepared with SES'}
                    </p>
                    {related.length > 0 && (
                      <ul class="mt-3 flex flex-wrap gap-2">
                        {related.slice(0, 3).map((p) => (
                          <li>
                            <a
                              href={`/projects/${p.id}/`}
                              class="inline-block border border-line px-3 py-1.5 text-xs font-medium text-body transition-colors hover:border-accent-500 hover:text-accent-700"
                            >
                              {p.data.title.length > 38 ? p.data.title.slice(0, 36) + '…' : p.data.title}
                            </a>
                          </li>
                        ))}
                        {related.length > 3 && (
                          <li class="px-1 py-1.5 text-xs text-muted">+{related.length - 3} more</li>
                        )}
                      </ul>
                    )}
                  </div>
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
